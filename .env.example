# ==========================================
# Generative AI & LangChain API Keys Config
# ==========================================
# Duplicate this file to '.env' and populate your actual API keys.
# NEVER commit your actual '.env' file to version control!

# Google Gemini API Key (Required for ChatGoogleGenerativeAI and GoogleGenerativeAIEmbeddings)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (Required for ChatGroq fast LLM inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Required for TavilySearch web search tool)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI API Key (Optional / for OpenAIEmbeddings and ChatGPT models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
